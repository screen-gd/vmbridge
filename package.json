{
  "name": "vmbridge",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "VMBRIDGE_DEV=1 bun --watch apps/cli/src/index.ts run",
    "typecheck": "tsc && tsc -p apps/web",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "build": "bun scripts/build.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@types/bun": "1.4.5",
    "bun-plugin-tailwind": "0.1.2",
    "typescript": "~5.9.3"
  }
}
